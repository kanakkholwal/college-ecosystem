{
  "name": "server",
  "version": "1.0.0",
  "description": "Node.js TypeScript Express and WebSocket application",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node dist/src/index.js",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "add_freshers": "tsx src/scripts/add_freshers.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "websocket"
  ],
  "author": "https://github.com/kanakkholwal",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^5.11.1",
    "mongoose": "^9.9.3",
    "multer": "^2.0.1",
    "node-html-parser": "^9.0.1",
    "read-excel-file": "^9.3.10",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.5.14",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.0"
}
