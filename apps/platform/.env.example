# Google OAuth
GOOGLE_ID=<GOOGLE_ID>
GOOGLE_SECRET=<GOOGLE_SECRET>

BETTER_AUTH_SECRET=<BETTER_AUTH_SECRET>
BETTER_AUTH_URL=http://localhost:3000 #Base URL of your app

# Shared between client and server
SERVER_IDENTITY=APP.NITH.<BETTER_AUTH_SECRET>

# Database
DATABASE_URL='postgresql://:'
NODE_ENV=testing # or production

MONGODB_URI=<MONGODB_URI>
REDIS_URL=<REDIS_URL>

# Configure either GOOGLE_GENERATIVE_AI_API_KEY or MISTRAL_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=<GOOGLE_GENERATIVE_AI_API_KEY>
MISTRAL_API_KEY=<MISTRAL_API_KEY>


# backend
BASE_SERVER_URL=http://localhost:8080
NEXT_PUBLIC_BASE_SERVER_URL=http://localhost:8080

# Email: EMAIL_PROVIDER is mail-server | smtp | resend | brevo | console
# Unset: uses mail-server when MAIL_EMAIL and MAIL_PASSWORD are set, else console in dev
EMAIL_PROVIDER=console
# mail-server (same vars as apps/mail-server; SMTP_HOST defaults to smtp-relay.brevo.com)
MAIL_EMAIL=
MAIL_PASSWORD=
EMAIL_FROM="College Platform <platform@nith.eu.org>"
# EMAIL_REPLY_TO=
# resend
RESEND_API_KEY=
# brevo
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# smtp (any server; Mailpit locally: SMTP_HOST=localhost SMTP_PORT=1025, no user)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
